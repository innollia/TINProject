[gd_resource type="Resource" script_class="DeductionCaseDefinition" load_steps="19" format=3]

[ext_resource type="Script" path="res://modules/dedution_casework/domain/deduction_case.gd" id="1_case"]
[ext_resource type="Script" path="res://modules/dedution_casework/domain/deduction_slot.gd" id="2_slot"]
[ext_resource type="Script" path="res://modules/dedution_casework/domain/deduction_term.gd" id="3_term"]

[sub_resource type="Resource" id="term_actor_archivist"]
script = ExtResource("3_term")
term_id = &"archivist"
display_name = "기록관 · 문서 담당"
conflict_slot_id = &"action"
conflict_term_id = &"hide_figure"

[sub_resource type="Resource" id="term_actor_impersonator"]
script = ExtResource("3_term")
term_id = &"impersonator"
display_name = "사칭 인계자 · 무명"

[sub_resource type="Resource" id="term_actor_custodian"]
script = ExtResource("3_term")
term_id = &"custodian"
display_name = "청동상 관리인"

[sub_resource type="Resource" id="term_action_destroy_box"]
script = ExtResource("3_term")
term_id = &"destroy_box"
display_name = "오르골을 부숴 흔적을 없애기"

[sub_resource type="Resource" id="term_action_impersonate"]
script = ExtResource("3_term")
term_id = &"impersonate"
display_name = "경찰을 사칭해 소녀를 데려가기"

[sub_resource type="Resource" id="term_action_hide_figure"]
script = ExtResource("3_term")
term_id = &"hide_figure"
display_name = "청동상 안에 숨겨 일곱 금형을 만들기"

[sub_resource type="Resource" id="term_motive_sell_rumor"]
script = ExtResource("3_term")
term_id = &"sell_rumor"
display_name = "오르골의 소문을 팔기"

[sub_resource type="Resource" id="term_motive_protect_contract"]
script = ExtResource("3_term")
term_id = &"protect_contract"
display_name = "소녀를 계약에서 숨기기"

[sub_resource type="Resource" id="term_motive_display_dance"]
script = ExtResource("3_term")
term_id = &"display_dance"
display_name = "영원한 춤을 전시하기"

[sub_resource type="Resource" id="term_certainty_confirmed_link"]
script = ExtResource("3_term")
term_id = &"confirmed_link"
display_name = "오르골과 소녀의 연결이 확인됨"

[sub_resource type="Resource" id="term_certainty_unresolved_link"]
script = ExtResource("3_term")
term_id = &"unresolved_link"
display_name = "오르골과 청동상의 연결은 설로 남음"
[sub_resource type="Resource" id="slot_actor"]
script = ExtResource("2_slot")
slot_id = &"actor"
label = "누가"
options = Array[ExtResource("3_term")]([SubResource("term_actor_archivist"), SubResource("term_actor_impersonator"), SubResource("term_actor_custodian")])
solution_id = &"impersonator"

[sub_resource type="Resource" id="slot_action"]
script = ExtResource("2_slot")
slot_id = &"action"
label = "어떻게"
options = Array[ExtResource("3_term")]([SubResource("term_action_destroy_box"), SubResource("term_action_impersonate"), SubResource("term_action_hide_figure")])
solution_id = &"impersonate"

[sub_resource type="Resource" id="slot_motive"]
script = ExtResource("2_slot")
slot_id = &"motive"
label = "왜"
options = Array[ExtResource("3_term")]([SubResource("term_motive_sell_rumor"), SubResource("term_motive_protect_contract"), SubResource("term_motive_display_dance")])
solution_id = &"protect_contract"

[sub_resource type="Resource" id="slot_certainty"]
script = ExtResource("2_slot")
slot_id = &"certainty"
label = "무엇이 확인되지 않았나"
options = Array[ExtResource("3_term")]([SubResource("term_certainty_confirmed_link"), SubResource("term_certainty_unresolved_link")])
solution_id = &"unresolved_link"
[resource]
script = ExtResource("1_case")
case_id = &"clockwork_song"
title = "끝없이 노래하는 오르골"
scene_ids = Array[StringName]([&"returning_box", &"empty_handoff", &"bronze_figure"])
scene_names = Array[String](["돌아온 오르골", "빈 경찰 인계실", "청동 소녀상"])
findings = Array[String](["부서진 오르골은 다른 손에 들어갈 때마다 같은 춤곡으로 돌아온다. 태엽 안쪽에는 일곱 홈이 있다.", "경찰 인계 문서에는 소녀를 데려간 담당자의 이름과 근무 기록이 함께 비어 있다.", "청동 소녀상 설계도 안쪽에는 오르골 크기의 빈 공간과 나중에 덧댄 납땜 자국이 남아 있다."])
details = Array[String](["일곱 홈은 일곱 오르골이 실제로 만들어졌다는 증거가 아니라 같은 금형을 썼다는 흔적일 수 있다.", "담당자란이 비었다고 경찰 전체가 소녀를 데려갔다는 뜻은 아니다. 누군가 기록의 앞부분을 지웠을 수 있다.", "청동상 안쪽의 빈 공간은 유해를 보관했다는 증거와 전시 장치를 숨겼다는 설을 동시에 남긴다."])
event_ids = Array[StringName]([&"box_wound", &"girl_handed_over", &"figure_hidden"])
event_names = Array[String](["오르골을 다시 태엽 감음", "소녀를 인계함", "청동상 안에 숨김"])
timeline_solution = Array[StringName]([&"girl_handed_over", &"box_wound", &"figure_hidden"])
answer_slots = Array[ExtResource("2_slot")]([SubResource("slot_actor"), SubResource("slot_action"), SubResource("slot_motive"), SubResource("slot_certainty")])
minimum_rechecks = 1
solved_text = "무명 사칭 인계자는 기록이 지워진 틈을 이용해 소녀를 데려갔다. 오르골과 청동상의 연결은 아직 설로 남는다."
