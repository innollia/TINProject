  "messages": [
    {
      "schema_version": 1,
      "id": "msg_cabin4_body",
      "title": "오브젝트 B1 — 위침대 4B의 시신",
      "body": "관찰: 위침대 4B에 한 사람의 시신. 비싼 갈색 코트. 왼손 새끼손가락 금반지.\n관찰: 목 뒤에 작은 자국 1개. 주변 바닥에 물자국은 없다.\n관찰: 창문 밖 6호차 승강장에 증원이 와 있다. 격리 요청에 답은 없다.",
      "source_refs": ["ent_person_merec", "ent_place_berth_4b", "ent_place_cabin_4", "ent_trace_injection", "ent_decoy_sara_died"],
      "prerequisite_condition": null,
      "effects": [
        { "schema_version": 1, "type": "discover_entity", "params": { "entity_ids": ["ent_person_merec", "ent_place_berth_4b", "ent_place_cabin_4", "ent_trace_injection", "ent_decoy_sara_died"] } },
        { "schema_version": 1, "type": "reveal_panel", "params": { "panel_id": "panel_main_statement" } }
      ],
      "detail_scene_id": ""
    },
    {
      "schema_version": 1,
      "id": "msg_cabin4_bedding",
      "title": "비수집형 시각단서 — 4B 사다리 아래 / 4A 침대 밑",
      "body": "관찰: 4B 사다리 아래에 큰 남성구두 한 켤레. 옆에 금색 새끼발가락 반지 보관함, 복용 직후라 병이 아직 닫힌 개인 약품 용기.\n관찰: 4A 아래침대 이불에 몸집이 작은 사람의 눌림. 침대 밑에 낮은 여성구두와 청색잉크 얼룩이 배인 양말.\n관찰: 두 묶음이 놓인 자리가 원래 배정표의 상·하단과 서로 반대다.",
      "source_refs": ["ent_state_bunk_marks", "ent_state_berth_mismatch"],
      "prerequisite_condition": null,
      "effects": [
        { "schema_version": 1, "type": "discover_entity", "params": { "entity_ids": ["ent_state_bunk_marks", "ent_state_berth_mismatch"] } },
        { "schema_version": 1, "type": "reveal_panel", "params": { "panel_id": "panel_inter_target_4b" } }
      ],
      "detail_scene_id": ""
    },
    {
      "schema_version": 1,
      "id": "msg_cabin4_bag_dented",
      "title": "오브젝트 B3 — 가방 ①",
      "body": "관찰: 갈색 가죽 가방. 한쪽 금속 모서리가 찌그러져 있다.\n관찰: 내부에 옷 몇 벌과 빈 서류봉투 하나. 금속 모서리 조각은 없다.\n비교: 메렉의 갈색 코트 주머니에서 나온 호텔 로비 사진. 같은 모서리 파손 그림이 보인다.",
      "source_refs": ["ent_bag_rough", "ent_trace_no_goods", "ent_decoy_merec_carried"],
      "prerequisite_condition": null,
      "effects": [
        { "schema_version": 1, "type": "discover_entity", "params": { "entity_ids": ["ent_bag_rough", "ent_trace_no_goods", "ent_decoy_merec_carried"] } }
      ],
      "detail_scene_id": ""
    },
    {
      "schema_version": 1,
      "id": "msg_cabin4_bag_blue",
      "title": "오브젝트 B4 — 가방 ② 손잡이 파란 실",
      "body": "관찰: 갈색 가방. 손잡이에 파란 실이 묶여 있다. 안쪽에 청색잉크 얼룩.\n비교: 세라의 산악마을 사진. 사진 속 손잡이에도 같은 파란 실과 같은 얼룩이 있다.",
      "source_refs": ["ent_bag_blue", "ent_person_sara"],
      "prerequisite_condition": null,
      "effects": [
        { "schema_version": 1, "type": "discover_entity", "params": { "entity_ids": ["ent_bag_blue", "ent_person_sara"] } }
      ],
      "detail_scene_id": ""
    },
    {
      "schema_version": 1,
      "id": "msg_cabin4_bag_blue_notes",
      "title": "하위 B4-1 — 노트 차례",
      "body": "관찰: 가방 안 노트 두 권. 표지 「I. 음운」, 「II. 식물명」.\n관찰: 두 권 사이에 「III. 현지 예문과 교정표」가 적힌 차례가 남아 있다. III권 자체는 없다.",
      "source_refs": ["ent_person_sara", "ent_book_volume_1", "ent_book_volume_2", "ent_book_volume_3"],
      "prerequisite_condition": null,
      "effects": [
        { "schema_version": 1, "type": "discover_entity", "params": { "entity_ids": ["ent_person_sara", "ent_book_volume_1", "ent_book_volume_2", "ent_book_volume_3"] } }
      ],
      "detail_scene_id": ""
    },
    {
      "schema_version": 1,
      "id": "msg_cabin4_bag_blue_gap",
      "title": "비수집형 시각단서 — 가방 ② 안의 세 번째 자리",
      "body": "관찰: 남은 두 권과 같은 폭의 눌린 자국 하나. 묶이던 청색 고정끈 한 가닥이 끊겨 있다.\n관찰: 고정끈 홈에서 청색 식물압착테이프를 뽑은 자국이 남아 있다.\n비교: 세라의 산악마을 사진. 사진 속 가방에는 세 권이 같은 고정끈에 세 겹으로 묶여 있다.",
      "source_refs": ["ent_state_missing_volume", "ent_trace_broken_tie", "ent_trace_blue_tape", "ent_decoy_robbery"],
      "prerequisite_condition": null,
      "effects": [
        { "schema_version": 1, "type": "discover_entity", "params": { "entity_ids": ["ent_state_missing_volume", "ent_trace_broken_tie", "ent_trace_blue_tape", "ent_decoy_robbery"] } }
      ],
      "detail_scene_id": ""
    },
    {
      "schema_version": 1,
      "id": "msg_platform_manifest",
      "title": "오브젝트 A3 — 취침배정표",
      "body": "인쇄:\n4A 메렉 솔\n4B 세라 퀼\n5A 베른 카스\n5B 유리 벤트\n하단 필기: 「퀼 씨, 위칸 멀미. 솔 씨와 상의.」",
      "source_refs": ["ent_person_merec", "ent_person_sara", "ent_person_bern", "ent_person_yuri", "ent_place_berth_4a", "ent_place_berth_4b", "ent_place_cabin_5", "ent_role_rare_documents", "ent_role_field_linguist", "ent_role_express_courier", "ent_role_travel_doctor"],
