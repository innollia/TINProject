  "messages": [
    {
      "schema_version": 1,
      "id": "msg_store_overview",
      "title": "비수집형 시각단서 — 창고 본실 / E09 포장틀",
      "body": "관찰: 일곱 상자가 흩어져 있다. A17·B04·C22·D11은 닫혀 있고 E09만 검사대 앞에서 열려 있다.\n관찰: E09 포장틀에 넓고 얇은 직사각형 먼지선이 남아 있다. 테두리에 검은 돌가루가 고여 있다.\n관찰: 같은 포장틀에 사다리꼴 손잡이와 둥근 돌기 두 개 모양의 새 압흔이 하나 더 있다.\n관찰: 바닥에는 서로 다른 방향의 지게차 자국과 소화수 흐름이 겹쳐 있다.",
      "source_refs": ["ent_trace_dust_outline", "ent_state_two_crates", "ent_place_crate_e09", "ent_place_store", "ent_decoy_seven_crates"],
      "prerequisite_condition": null,
      "effects": [
        { "schema_version": 1, "type": "discover_entity", "params": { "entity_ids": ["ent_trace_dust_outline", "ent_state_two_crates", "ent_place_crate_e09", "ent_place_store", "ent_decoy_seven_crates"] } },
        { "schema_version": 1, "type": "reveal_panel", "params": { "panel_id": "panel_main_statement" } },
        { "schema_version": 1, "type": "reveal_panel", "params": { "panel_id": "panel_inter_two_crates_one_object" } }
      ],
      "detail_scene_id": ""
    },
    {
      "schema_version": 1,
      "id": "msg_store_chalk",
      "title": "오브젝트 B1 — 붉은 검사분필선",
      "body": "관찰: A17·B04·C22·D11 상자 옆에 검사완료 사선이 그어져 있다. E09 옆 사선은 없다.\n관찰: 사선이 끝난 네 상자 모서리에는 같은 붉은 분필이 조금씩 묻어 있다.\n관찰: 사선을 긋는 방향이 세 구간에서 같다.",
      "source_refs": ["ent_person_olren", "ent_role_customs_officer", "ent_place_crate_e09", "ent_place_crate_d11"],
      "prerequisite_condition": null,
      "effects": [
        { "schema_version": 1, "type": "discover_entity", "params": { "entity_ids": ["ent_person_olren", "ent_role_customs_officer", "ent_place_crate_e09", "ent_place_crate_d11"] } }
      ],
      "detail_scene_id": ""
    },
    {
      "schema_version": 1,
      "id": "msg_store_e09_seal",
      "title": "오브젝트 B2 — E09 봉인과 내부",
      "body": "관찰: E09 뚜껑에 세관봉인. 겉보기엔 온전하다. 실은 새것이다.\n관찰: 새 실 사이에 검은 밀랍 미세조각이 박혀 있다.\n관찰: 내부 포장틀 한 칸에 금속물이 들어 있다. 윗면에 22kg 각인. 사다리꼴 손잡이와 둥근 돌기 두 개가 있다.",
      "source_refs": ["ent_customs_seal", "ent_weight_22kg", "ent_place_crate_e09"],
      "prerequisite_condition": null,
      "effects": [
        { "schema_version": 1, "type": "discover_entity", "params": { "entity_ids": ["ent_customs_seal", "ent_weight_22kg", "ent_place_crate_e09"] } }
      ],
      "detail_scene_id": ""
    },
    {
      "schema_version": 1,
      "id": "msg_store_g02_tray",
      "title": "비수집형 시각단서 — G02 내부 트레이",
      "body": "관찰: G02 내부 포대 하나가 비어 있다.\n관찰: 빈 포대에 남은 눌림은 사다리꼴 손잡이와 둥근 돌기 두 개 모양이다.\n비교: E09 내부 금속물의 손잡이와 돌기 간격. 두 압흔의 폭이 같다.\n관찰: G02 뚜껑 안쪽 먼지는 고르게 쌓여 있다.",
      "source_refs": ["ent_state_trapezoid_gap", "ent_place_crate_g02", "ent_weight_22kg"],
      "prerequisite_condition": null,
      "effects": [
        { "schema_version": 1, "type": "discover_entity", "params": { "entity_ids": ["ent_state_trapezoid_gap", "ent_place_crate_g02", "ent_weight_22kg"] } },
        { "schema_version": 1, "type": "reveal_panel", "params": { "panel_id": "panel_inter_two_crates_one_object" } }
      ],
      "detail_scene_id": ""
    },
    {
      "schema_version": 1,
      "id": "msg_store_ignition",
      "title": "오브젝트 B3 — 화점의 포장면천",
      "body": "관찰: 화점 표시 아래 포장면천에 그을음이 바닥에서 위로 V자로 퍼져 있다.\n관찰: V자 바깥을 지나는 천장 전기배선에는 그을음이 없다.\n관찰: 검사표 기재: 가속제 성분 검출.",
      "source_refs": ["ent_trace_ree_soot", "ent_state_wired_intact", "ent_place_store", "ent_decoy_electrical"],
      "prerequisite_condition": null,
      "effects": [
        { "schema_version": 1, "type": "discover_entity", "params": { "entity_ids": ["ent_trace_ree_soot", "ent_state_wired_intact", "ent_place_store", "ent_decoy_electrical"] } },
        { "schema_version": 1, "type": "reveal_panel", "params": { "panel_id": "panel_inter_olren_discovery" } }
      ],
      "detail_scene_id": ""
    },
    {
      "schema_version": 1,
      "id": "msg_store_pocket",
      "title": "오브젝트 B4 — 올렌 주머니",
      "body": "관찰: 회색 제복 주머니에서 깨진 흑색석판 조각이 나왔다.\n비교: E09 포장틀 먼지선 테두리 가루와 창고바닥의 검은 돌가루. 세 재질의 색과 입자가 같다.\n관찰: 조각 한 면은 매끈하다. 두께 면은 거칠다.",
      "source_refs": ["ent_stone_shard", "ent_stone_panel", "ent_person_olren", "ent_state_panel_void"],
      "prerequisite_condition": null,
      "effects": [
        { "schema_version": 1, "type": "discover_entity", "params": { "entity_ids": ["ent_stone_shard", "ent_stone_panel", "ent_person_olren", "ent_state_panel_void"] } }
      ],
      "detail_scene_id": ""
    },
    {
      "schema_version": 1,
      "id": "msg_yard_nyle",
