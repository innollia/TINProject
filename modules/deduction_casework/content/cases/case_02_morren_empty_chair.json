  "messages": [
    {
      "schema_version": 1,
      "id": "msg_dining_guest_seat",
      "title": "오브젝트 B2 — 사용되지 않은 한 자리",
      "body": "관찰: 여섯 자리 중 다섯 자리에는 이름표와 사용흔적이 서로 다르게 남아 있다.\n관찰: 남는 한 자리만 수프 표면에 막이 있고 접힌 냅킨이 한 번도 펴지지 않았다.\n관찰: 그 의자만 통로 쪽으로 비스듬히 밀려 있고 등받이에 젖은 외투가 걸려 있다.",
      "source_refs": ["ent_trace_cold_soup", "ent_trace_chair_back", "ent_trace_wet_coat", "ent_action_left_table"],
      "prerequisite_condition": null,
      "effects": [
        { "schema_version": 1, "type": "discover_entity", "params": { "entity_ids": ["ent_trace_cold_soup", "ent_trace_chair_back", "ent_trace_wet_coat", "ent_action_left_table"] } },
        { "schema_version": 1, "type": "reveal_panel", "params": { "panel_ids": ["panel_main_statement", "panel_inter_empty_seat_route"] } }
      ],
      "detail_scene_id": ""
    },
    {
      "schema_version": 1,
      "id": "msg_dining_visual_seats",
      "title": "비수집형 시각단서 — 여섯 자리의 사용상태",
      "body": "관찰: 이름표를 모두 걷어 내면 세 가족 좌석 등받이에는 같은 문장 자수, 한 자리에는 서류가방 자국, 한 자리에는 앞치마 고리 자국이 남는다.\n관찰: 남는 평의자 하나만 사용흔적이 전혀 없다. 이 자리가 가족 좌석이 아니라는 사실은 문서가 아니라 자리 자체가 말해 준다.",
      "source_refs": ["ent_seat_guest", "ent_seat_family"],
      "prerequisite_condition": null,
      "effects": [
        { "schema_version": 1, "type": "discover_entity", "params": { "entity_ids": ["ent_seat_guest", "ent_seat_family"] } }
      ],
      "detail_scene_id": ""
    },
    {
      "schema_version": 1,
      "id": "msg_dining_seat_plan",
      "title": "오브젝트 B1 — 식탁 자리표",
      "body": "관찰: 여섯 자리만 표시된 표. 가족 셋 / 법률대리인 / 집사 / 그리고 이름 대신 '외부 손님' 한 칸.",
      "source_refs": ["ent_role_guest"],
      "prerequisite_condition": null,
      "effects": [
        { "schema_version": 1, "type": "discover_entity", "params": { "entity_id": "ent_role_guest" } }
