// dsc.amb_dread — the wrong kind of quiet
// A tritone held under a slow tremolo. Nothing here resolves. Loop 16 s at
// bpm 60.
bpm = 60

trem = sine(0.125) * 0.35 + 0.65
bitone = saw(82.4) * 0.5 + saw(116.54) * 0.5 + sine(164.81) * 0.2
shaped = bitone * trem * 0.16 |> lp(@, 700, 1.4)
wide = shaped |> chorus(@, 0.125, 0.6, 18.0, 9.0, 0.25, 0.7, 0.3)

out(wide.pan(-0.2), wide.pan(0.2))
